      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Sent by type",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (job, instance, type) (rate(kea_dhcp4_packets_sent_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} {{type}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 47,
        "w": 12,
        "h": 8
      }
    },
