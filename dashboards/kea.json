      "id": 25,
      "type": "row",
      "title": "DHCPv4 drops",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 26,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Dropped by reason",
