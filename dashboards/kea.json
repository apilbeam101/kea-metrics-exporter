{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "Kea DHCP",
  "uid": "kea-metrics-exporter",
  "description": "Generated by scripts/generate-dashboard.ts from kea-metrics-exporter metrics.",
  "tags": [
    "kea",
    "dhcp"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kea_up, job)",
          "refId": "job"
        },
        "definition": "label_values(kea_up, job)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kea_up{job=~\"$job\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(kea_up{job=~\"$job\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "sort": 1
      },
      {
        "name": "relationship",
        "label": "HA relationship",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kea_ha_relationship_info{job=~\"$job\"}, relationship)",
          "refId": "relationship"
        },
        "definition": "label_values(kea_ha_relationship_info{job=~\"$job\"}, relationship)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "sort": 1
      },
      {
        "name": "subnet_id",
        "label": "Subnet ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kea_dhcp4_subnet_addresses{job=~\"$job\", instance=~\"$instance\"}, subnet_id)",
          "refId": "subnet_id"
        },
        "definition": "label_values(kea_dhcp4_subnet_addresses{job=~\"$job\", instance=~\"$instance\"}, subnet_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Exporter health",
      "collapsed": false,
      "description": "First: a dashboard that looks green while the exporter is down is the worst outcome.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "stat",
      "title": "Exporter reachable",
      "description": "Prometheus's own up for each scrape target.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "stat",
      "title": "Kea daemon up",
      "description": "kea_up: the daemon answered status-get and accepted the credential.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kea_up{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Cache age",
      "description": "Seconds since each target's last successful poll.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kea_exporter_cache_age_seconds{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Poll errors",
      "description": "Failed commands per second, by reason.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (job, instance, reason) (rate(kea_exporter_poll_errors_total{job=~\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{instance}} {{reason}}"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "table",
      "title": "Failing collectors",
      "description": "Collectors whose last cycle failed. Empty is healthy.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "expr": "kea_collector_success{job=~\"$job\", instance=~\"$instance\"} == 0"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 6
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "High availability",
      "collapsed": false,
      "description": "Empty when no target loads the HA hook.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "state-timeline",
      "title": "HA state",
      "description": "Each server's own HA state.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (relationship, server, state) (kea_ha_state{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"}) == 1",
          "legendFormat": "{{server}}: {{state}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "state-timeline",
      "title": "Partner state as seen by each side",
      "description": "The partner's last state, as each server last learned it.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (relationship, partner, instance, state) (kea_ha_partner_last_state{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"}) == 1",
          "legendFormat": "{{instance}} sees {{partner}}: {{state}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Scopes served",
      "description": "Scopes each server is serving. A relationship where every server serves zero is down.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (relationship, server) (kea_ha_scopes_served{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"})",
          "legendFormat": "{{server}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Communication interrupted",
      "description": "1 while a server has lost contact with its partner.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, partner) (kea_ha_communication_interrupted{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"})",
          "legendFormat": "{{instance}} → {{partner}}"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 21,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Unacked clients left before failover",
      "description": "How many more unanswered clients before partner-down.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, partner) (kea_ha_unacked_clients_left{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"})",
          "legendFormat": "{{instance}} → {{partner}}"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Clock skew",
      "description": "Partner clock minus local clock. Kea terminates HA above 60 seconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max by (instance, partner) (kea_ha_clock_skew_seconds{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"})",
          "legendFormat": "{{instance}} → {{partner}}"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 21,
        "w": 6,
        "h": 6
      }
    },
    {
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "table",
      "title": "Relationships",
      "description": "Each relationship's mode and each side's role.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "expr": "kea_ha_relationship_info{job=~\"$job\", instance=~\"$instance\", relationship=~\"$relationship\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 6
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Instance overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "table",
      "title": "Versions",
      "description": "Reported Kea version per daemon.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "expr": "kea_server_version_info{job=~\"$job\", instance=~\"$instance\"}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 8,
        "h": 6
      }
    },
    {
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Uptime",
      "description": "Seconds since each daemon started.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - kea_start_time_seconds{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 34,
        "w": 8,
        "h": 6
      }
    },
    {
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Since last reload",
      "description": "Seconds since the last configuration reload.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "time() - kea_config_reload_timestamp_seconds{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 6
      }
    },
    {
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "table",
      "title": "Socket status",
      "description": "DHCP socket status. Anything but ready means the daemon cannot serve on some interface.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "format": "table",
          "expr": "kea_control_socket_status{job=~\"$job\", instance=~\"$instance\"} == 1"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 6
      }
    },
    {
      "id": 20,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Service disabled",
      "description": "1 while the DHCP service is globally disabled.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kea_service_globally_disabled{job=~\"$job\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 6
      }
    },
    {
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Packet queue depth",
      "description": "Average queue depth over the last 100 packets (multi-threaded daemons).",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "kea_packet_queue_depth_avg{job=~\"$job\", instance=~\"$instance\", window=\"100\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 6
      }
    },
    {
      "id": 22,
      "type": "row",
      "title": "DHCPv4 packets",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 23,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "type": "timeseries",
      "title": "Received by type",
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
