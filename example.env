# Copy this file to .env and fill in real values. See docs/DESIGN.md §6 for
# the full configuration reference. Per-target overrides are named
# <VARIABLE>__<NAME>, where <NAME> is the target name upper-cased with "-"
# replaced by "_". An override naming no configured target is a startup error.

# --- Targets ---------------------------------------------------------------

# One target per Kea daemon control socket.
KEA_TARGETS=dhcp4-a=https://kea-a.example.com:8004,dhcp4-b=https://kea-b.example.com:8004

# dhcp4, dhcp6 or d2. No default: every target must resolve to one.
KEA_DAEMON=dhcp4
# KEA_DAEMON__DHCP6_A=dhcp6

# --- Credentials -----------------------------------------------------------

KEA_USERNAME=
# Prefer the file form. KEA_PASSWORD and KEA_PASSWORD_FILE are mutually
# exclusive per target. The file is read once at startup.
KEA_PASSWORD_FILE=
# KEA_PASSWORD=
# KEA_PASSWORD_FILE__DHCP4_B=

# --- Upstream TLS ----------------------------------------------------------

# KEA_CA_BUNDLE_PATH=
# Kea HTTPS sockets default to cert-required: true. Both or neither.
# KEA_CLIENT_CERT_PATH=
# KEA_CLIENT_KEY_PATH=
# KEA_TLS_INSECURE_SKIP_VERIFY=false

# --- Behaviour -------------------------------------------------------------

METRICS_PORT=10167
METRICS_BIND_ADDRESS=0.0.0.0
POLL_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_BYTES=67108864
MAX_SUBNETS=2048
ENABLE_POOL_STATS=true
# Adds prefix and shared_network labels. Needs Kea's subnet_cmds hook.
ENABLE_SUBNET_LABELS=false
ENABLE_D2_KEY_STATS=false
ENABLE_DEFAULT_METRICS=true
LOG_LEVEL=info
LOG_FORMAT=json

# --- Metrics listener TLS (optional) ---------------------------------------

# METRICS_TLS_CERT_PATH=
# METRICS_TLS_KEY_PATH=
# METRICS_TLS_CLIENT_CA_PATH=
# METRICS_TLS_MIN_VERSION=TLSv1.2
